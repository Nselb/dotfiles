configuration {
    show-icons:     false;
    font:           "JetBrains Mono 11";
}

* {
    bg:         #1e1e2e;
    bg-alt:     #313244;
    fg:         #cdd6f4;
    fg-muted:   #6c7086;
    accent:     #89b4fa;
    border-col: rgba(137,180,250,0.20);

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    12px;
    width:            380px;
    padding:          0;
}

mainbox {
    spacing:  0;
    padding:  0;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg;
    border:           0 0 1px 0;
    border-color:     @border-col;
    padding:          14px 14px 10px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    padding:          0 4px 0 0;
    font:             "JetBrains Mono Bold 11";
}

entry {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-col;
    border-radius:    6px;
    padding:          6px 10px;
    text-color:       @fg;
    placeholder:      "Buscar red...";
    placeholder-color: @fg-muted;
    expand:           true;
}

listview {
    padding:        6px 0;
    spacing:        0;
    scrollbar:      false;
    lines:          8;
}

element {
    padding:      9px 16px;
    border-radius: 0;
    spacing:      0;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: rgba(137,180,250,0.15);
    text-color:       @accent;
    border:           0 0 0 2px;
    border-color:     @accent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "JetBrains Mono 11";
}
